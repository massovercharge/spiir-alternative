# Peng Environment Configuration
# Copy this file to .env before running `docker compose up -d`

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------

# Port for the web interface (default: 8080)
PENG_UI_PORT=8080

# Directory where database and logs are stored (default: ./data)
PENG_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Security & Authentication
# ---------------------------------------------------------------------------

# Authentication provider: "none", "basic"
# For local network / VPN use, "none" is recommended.
AUTH_PROVIDER=none

# If AUTH_PROVIDER=basic, configure these:
PENG_AUTH_USERNAME=admin
# PENG_AUTH_PASSWORD=your_secure_password_here

# ---------------------------------------------------------------------------
# Enable Banking Integration (PSD2 / AIS)
# ---------------------------------------------------------------------------

# Get these by registering an app at https://enablebanking.com
ENABLEBANKING_APP_ID=your-enable-banking-app-id

# Must match the Redirect URI configured in Enable Banking console
ENABLEBANKING_REDIRECT_URL=http://localhost:8080/callback

# Path to the RSA private key you generated for Enable Banking
ENABLEBANKING_PRIVATE_KEY_PATH=/app/data/local_secrets/enablebanking/private_key.pem